#!/bin/sh /etc/rc.common
# Keep the module's heartbeat listener independent of QMI discovery/probes.
START=14
STOP=89
USE_PROCD=1

start_service() {
	. /lib/functions/system.sh
	[ "$(board_name)" = oppo,ckb01 ] || return 0
	ip link set dev lo up
	ip addr add 169.254.10.1/32 dev lo 2>/dev/null || true
	procd_open_instance
	procd_set_param command /usr/sbin/uhttpd -f -p 169.254.10.1:19888 -h /usr/share/ckb01-modem/heartbeat
	procd_set_param respawn 60 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
