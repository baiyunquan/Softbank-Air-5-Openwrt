#!/bin/sh
# Async procd service; never holds the rest of boot for channel discovery.

retrain_pcie() {
 [ -e /sys/bus/pci/devices/0000:01:00.0 ] && return 0
 [ -n "$_retrain_attempted" ] && return 0
 _retrain_attempted=1
 if [ -d /sys/bus/pci/devices/0000:00:00.0 ]; then
  echo on > /sys/bus/pci/devices/0000:00:00.0/power/control 2>/dev/null
  sleep 1
  echo 1 > /sys/bus/pci/rescan 2>/dev/null
 fi
}

# The independent S14ckb01-heartbeat procd service owns TCP19888.
started=$(cut -d. -f1 /proc/uptime)
while :; do
 retrain_pcie
 discovery=$(ckb01-modem discover 2>/dev/null)
 management=$(printf '%s' "$discovery" | jsonfilter -e '@.management')
 if [ -n "$management" ]; then
  ip link set dev "$management" up
  ip addr replace 169.254.10.1/24 dev "$management"
 fi
 ready=$(printf '%s' "$discovery" | jsonfilter -e '@.ok')
 if [ "$ready" = true ]; then
  printf '%s\n' "$discovery" > /tmp/ckb01-modem-discovery.json
  if ! ping -c 2 -W 2 -I "$management" 169.254.10.2 > /tmp/ckb01-modem-management.txt 2>&1; then
   logger -t ckb01-modem 'IP_SW0 exists but module management does not respond; skip automatic QMI probes/dialing, retain wired/Wi-Fi, no MHI reset'
   exit 1
  fi
  if ! /bin/busybox timeout 45 ckb01-modem probe > /tmp/ckb01-modem-baseline.json 2>&1; then
   logger -t ckb01-modem 'Baseline probe failed/timed out; enumerated interfaces do not prove working QMI or management transport'
  fi
  logger -t ckb01-modem 'MHI interfaces enumerated; inspect baseline for actual control responses; no automatic PDC changes'
  ifup cellular
  exit 0
 fi
 now=$(cut -d. -f1 /proc/uptime)
 [ "$((now - started))" -lt 120 ] || break
 sleep 2
done
printf '%s\n' "$discovery" > /tmp/ckb01-modem-discovery.json
logger -t ckb01-modem 'Timed out waiting 120s for MHI interfaces; wired LAN retained; no MHI reset'
exit 1
