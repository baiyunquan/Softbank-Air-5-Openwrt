#!/bin/sh /etc/rc.common
START=97
STOP=10
USE_PROCD=1
start_service() {
 [ "$(cat /tmp/sysinfo/board_name)" = oppo,ckb01 ] || return 0
 rm -f /tmp/ckb01-diag-efs.stopping
 procd_open_instance
 procd_set_param command /usr/sbin/ckb01-diag-efs daemon
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param term_timeout 15
 procd_close_instance
}
stop_service() {
 touch /tmp/ckb01-diag-efs.stopping
 [ ! -e /tmp/ckb01-edl-active ] || return 0
 /usr/sbin/ckb01-diag-efs _stop || logger -t ckb01-diag-efs 'Could not stop module DIAG owner; inspect management link (no reset attempted)'
}
