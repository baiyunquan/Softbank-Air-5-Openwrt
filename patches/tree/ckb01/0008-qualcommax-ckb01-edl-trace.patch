++/* Only explicit CKB01 maintenance sessions emit these breadcrumbs. All
++ * values are already available on the host; no diagnostic register reads.
++ * Never invoke from a printk/console implementation or add sleeping here.
++ */
++static inline bool mhi_ckb01_edl_tracing(struct mhi_controller *cntrl)
++{
++	return cntrl->ckb01_edl_maintenance &&
++		(READ_ONCE(cntrl->ckb01_edl_armed) || cntrl->ckb01_edl_active);
++}
++
++static inline void mhi_ckb01_edl_emit(struct mhi_controller *cntrl,
++		const char *stage, const char *edge, int rc, u64 a, u64 b, unsigned int op)
++{
++	unsigned int seq;
++
++	if (!mhi_ckb01_edl_tracing(cntrl))
++		return;
++	WRITE_ONCE(cntrl->ckb01_edl_trace_stage, stage);
++	WRITE_ONCE(cntrl->ckb01_edl_trace_edge, edge);
++	seq = atomic_inc_return(&cntrl->ckb01_edl_trace_seq);
++	dev_info(cntrl->cntrl_dev,
++		 "CKB01-EDL seq=%u cpu=%u op=%u stage=%s edge=%s rc=%d a=0x%llx b=0x%llx pm=0x%x ee=%u\n",
++		 seq, raw_smp_processor_id(), op, stage, edge, rc,
++		 (unsigned long long)a, (unsigned long long)b,
++		 READ_ONCE(cntrl->pm_state), READ_ONCE(cntrl->ee));
++}
++
++static inline void mhi_ckb01_edl_trace(struct mhi_controller *cntrl,
++		const char *stage, const char *edge, int rc, u64 a, u64 b)
++{
++	mhi_ckb01_edl_emit(cntrl, stage, edge, rc, a, b, 0);
++}
++
++/* One budget covers PCI configuration and MMIO pairs across AMSS -> FP.
++ * Every admitted begin has an end if its operation returns, even when another
++ * CPU exhausts the budget. High-level stage logs are never budget-suppressed.
++ */
++static inline unsigned int mhi_ckb01_edl_io_begin(struct mhi_controller *cntrl,
++		const char *stage, u64 offset, u64 value)
++{
++	unsigned int id, limit;
++
++	if (!mhi_ckb01_edl_tracing(cntrl))
++		return 0;
++	limit = READ_ONCE(cntrl->ckb01_edl_trace_limit);
++	if (!limit)
++		return 0;
++	id = atomic_inc_return(&cntrl->ckb01_edl_trace_io);
++	if (id > limit) {
++		if (id == limit + 1)
++			mhi_ckb01_edl_trace(cntrl, "io-budget", "exhausted", 0, limit, 0);
++		return 0;
++	}
++	mhi_ckb01_edl_emit(cntrl, stage, "begin", 0, offset, value, id);
++	return id;
++}
++
++static inline void mhi_ckb01_edl_io_end(struct mhi_controller *cntrl,
++		unsigned int id, const char *stage, int rc, u64 offset, u64 value)
++{
++	if (id)
++		mhi_ckb01_edl_emit(cntrl, stage, "end", rc, offset, value, id);
++}
++
