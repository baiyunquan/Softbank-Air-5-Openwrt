++	.num_events = ARRAY_SIZE(modem_qcom_v1_mhi_events),
++	.event_cfg = modem_qcom_v1_mhi_events,
++};
++
++static const struct mhi_pci_dev_info ckb01_sdx55_info = {
++	.name = "ckb01-sdx55",
++	.config = &ckb01_sdx55_config,
++	.bar_num = MHI_PCI_DEFAULT_BAR_NUM,
++	.dma_data_width = 32,
++	.mru_default = 32768,
+ };
+ 
+ static const struct mhi_pci_dev_info mhi_qcom_sdx55_info = {
+@@ -1304,6 +1339,12 @@
+ 	unsigned int dma_data_width;
+ 	int err;
+ 
++	/* Preserve Foxconn matching on every other board/subsystem. */
++	if (of_machine_is_compatible("oppo,ckb01") &&
