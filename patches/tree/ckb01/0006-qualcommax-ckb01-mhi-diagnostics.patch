++static bool dw_ckb01_target(struct dw_ckb01_msi *diag, unsigned long hw)
++{
++	return diag && hw < MAX_MSI_IRQS &&
++		(READ_ONCE(diag->target[hw / 32]) & BIT(hw % 32));
++}
