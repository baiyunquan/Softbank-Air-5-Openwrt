+--- /dev/null
++++ b/drivers/bus/mhi/host/ckb01_diag.c
+@@ -0,0 +1,381 @@
++// SPDX-License-Identifier: GPL-2.0
++/* CKB01-only observation and a bounded, explicitly requested event consumer. */
++#include <linux/debugfs.h>
++#include <linux/irq.h>
++#include <linux/irqdomain.h>
++#include <linux/ktime.h>
++#include <linux/mhi.h>
++#include <linux/module.h>
++#include <linux/msi.h>
++#include <linux/of.h>
++#include <linux/pci.h>
++#include <linux/seq_file.h>
++#include <linux/slab.h>
++#include <linux/uaccess.h>
++#include <linux/unaligned.h>
++#include "internal.h"
++
++#define CKB01_POLL_MS 20
++#define CKB01_WINDOW_MS 30000
++#define CKB01_POLL_BUDGET 64
++#define CKB01_TOTAL_BUDGET 4096
++#define CKB01_RINGS 14
++#define CKB01_LOG_BUDGET 256
++
++struct mhi_diag {
++	struct mhi_controller *cntrl;
++	struct delayed_work work;
++	struct mutex control;
++	atomic64_t count[CKB01_RINGS + 1][MHI_DIAG_MAX];
++	u32 id;
++	u32 consumed;
++	u32 rounds;
++	atomic_t printed;
++	atomic_t samples[MHI_DIAG_MAX];
++	unsigned long deadline;
++	bool enabled;
++	bool polling;
++	bool dead;
++};
++
++static const char * const stage_name[MHI_DIAG_MAX] = {
++	"irq", "irq_empty", "schedule", "task", "event", "complete",
++	"queue", "channel_db", "event_db", "net_tx", "net_rx", "refill",
++	"qmi_tx", "qmi_rx", "channel_state", "poll", "error",
++};
++
++void mhi_diag_trace(struct mhi_controller *cntrl, enum mhi_diag_stage stage,
++		    int er, int ch, u64 a, u64 b, int rc)
++{
++	struct mhi_diag *diag = READ_ONCE(cntrl->diag);
++	unsigned int slot = er >= 0 && er < CKB01_RINGS ? er : CKB01_RINGS;
++	bool software = false;
++
++	if (!diag || stage >= MHI_DIAG_MAX)
++		return;
++	atomic64_inc(&diag->count[slot][stage]);
++	if (stage == MHI_DIAG_ERROR) {
++		dev_err_ratelimited(cntrl->cntrl_dev,
++			"CKB01-MHI ts_ns=%llu id=%u stage=error er=%d ch=%d a=%#llx b=%#llx rc=%d\n",
++			ktime_get_ns(), READ_ONCE(diag->id), er, ch, a, b, rc);
++		return;
++	}
++	if (!READ_ONCE(diag->enabled) ||
++	    atomic_inc_return(&diag->samples[stage]) > 16 ||
++	    atomic_inc_return(&diag->printed) > CKB01_LOG_BUDGET)
++		return;
++	if (er >= 0 && er < cntrl->total_ev_rings &&
++	    stage != MHI_DIAG_IRQ && stage != MHI_DIAG_SCHEDULE)
++		software = READ_ONCE(cntrl->mhi_event[er].diag_polling);
++	dev_info(cntrl->cntrl_dev,
++		 "CKB01-MHI ts_ns=%llu id=%u stage=%s src=%s er=%d ch=%d a=%#llx b=%#llx rc=%d\n",
++		 ktime_get_ns(), READ_ONCE(diag->id), stage_name[stage],
++		 software ? "poll" : "normal", er, ch, a, b, rc);
++}
++EXPORT_SYMBOL_GPL(mhi_diag_trace);
++
++/* May be called from a fault tasklet/timer: no waiting or BAR access. */
++void mhi_diag_abort(struct mhi_controller *cntrl)
++{
++	struct mhi_diag *diag = READ_ONCE(cntrl->diag);
++
++	if (!diag)
++		return;
++	WRITE_ONCE(diag->dead, true);
++	WRITE_ONCE(diag->enabled, false);
++	WRITE_ONCE(diag->polling, false);
++}
++EXPORT_SYMBOL_GPL(mhi_diag_abort);
++
++void mhi_diag_stop(struct mhi_controller *cntrl)
++{
++	struct mhi_diag *diag = cntrl->diag;
++
++	if (!diag)
++		return;
++	mutex_lock(&diag->control);
++	WRITE_ONCE(diag->enabled, false);
++	WRITE_ONCE(diag->polling, false);
++	cancel_delayed_work_sync(&diag->work);
++	mutex_unlock(&diag->control);
++}
++
++static void mhi_diag_work(struct work_struct *work)
++{
++	static const u32 rings[] = { 1, 2, 4, 5 };
++	struct mhi_diag *diag = container_of(to_delayed_work(work), struct mhi_diag, work);
++	struct mhi_controller *cntrl = diag->cntrl;
++	u32 i;
++	int ret = 0;
++	u16 vendor;
++
++	if (!READ_ONCE(diag->enabled))
++		return;
++	if (time_after_eq(jiffies, diag->deadline) || diag->consumed >= CKB01_TOTAL_BUDGET)
++		goto done;
++	if (!READ_ONCE(diag->polling))
++		goto next;
++
++	/* Serialize with disable transitions. Cancel this work before freeing contexts. */
++	if (!mutex_trylock(&cntrl->pm_mutex))
++		goto next;
++	if (READ_ONCE(diag->dead) || !mhi_is_active(cntrl) || !cntrl->mhi_ctxt ||
++	    cntrl->pm_state != MHI_PM_M0 || cntrl->ee != MHI_EE_AMSS) {
++		ret = -ENODEV;
++		goto unlock;
++	}
++	if (pci_read_config_word(to_pci_dev(cntrl->cntrl_dev), PCI_VENDOR_ID, &vendor) ||
++	    vendor != 0x17cb) {
++		mhi_diag_abort(cntrl);
++		ret = -ENODEV;
++		goto unlock;
++	}
++	for (i = 0; i < ARRAY_SIZE(rings); i++) {
++		struct mhi_event *ev = &cntrl->mhi_event[rings[i]];
++		void *before;
++		u32 consumed;
++		u32 raw_budget = min_t(u32, CKB01_POLL_BUDGET,
++				       CKB01_TOTAL_BUDGET - diag->consumed);
++
++		if (!raw_budget || !READ_ONCE(diag->enabled))
++			break;
++		if (ev->offload_ev || ev->cl_manage || ev->data_type != MHI_ER_DATA) {
++			ret = -EINVAL;
++			break;
++		}
++		spin_lock_bh(&ev->lock);
++		before = ev->ring.rp;
++		ev->diag_polling = true;
++		ret = mhi_process_data_event_ring_budget(cntrl, ev, raw_budget, raw_budget);
++		ev->diag_polling = false;
++		consumed = (ev->ring.rp - before + ev->ring.len) % ev->ring.len;
++		consumed /= sizeof(struct mhi_ring_element);
++		spin_unlock_bh(&ev->lock);
++		diag->consumed += consumed;
++		mhi_diag_trace(cntrl, MHI_DIAG_POLL, rings[i], -1,
++			       consumed, diag->consumed, ret < 0 ? ret : 0);
++		if (ret < 0)
++			break;
++	}
++unlock:
++	mutex_unlock(&cntrl->pm_mutex);
++	if (ret < 0) {
++		mhi_diag_trace(cntrl, MHI_DIAG_ERROR, -1, -1, diag->consumed, 0, ret);
++		goto done;
++	}
++next:
++	diag->rounds++;
++	if (READ_ONCE(diag->enabled))
++		schedule_delayed_work(&diag->work, msecs_to_jiffies(CKB01_POLL_MS));
++	return;
++done:
++	WRITE_ONCE(diag->enabled, false);
++	WRITE_ONCE(diag->polling, false);
++	dev_info(cntrl->cntrl_dev,
++		 "CKB01-MHI ts_ns=%llu id=%u stage=window_end consumed=%u rounds=%u rc=%d\n",
++		 ktime_get_ns(), diag->id, diag->consumed, diag->rounds, ret);
++}
++
++static void mhi_diag_irq_map(struct seq_file *m, struct mhi_controller *cntrl)
++{
++	struct pci_dev *pdev = to_pci_dev(cntrl->cntrl_dev);
++	u16 vendor = 0xffff, flags = 0;
++	u32 lo = 0, hi = 0, data = 0, mask = 0, pending = 0;
++	int cap, i, depth;
++	bool alive = !pci_read_config_word(pdev, PCI_VENDOR_ID, &vendor) && vendor == 0x17cb;
++
++	cap = pdev->msi_cap;
++	if (alive && cap) {
++		pci_read_config_word(pdev, cap + PCI_MSI_FLAGS, &flags);
++		pci_read_config_dword(pdev, cap + PCI_MSI_ADDRESS_LO, &lo);
++		if (flags & PCI_MSI_FLAGS_64BIT)
++			pci_read_config_dword(pdev, cap + PCI_MSI_ADDRESS_HI, &hi);
++		pci_read_config_dword(pdev, cap + ((flags & PCI_MSI_FLAGS_64BIT) ?
++				      PCI_MSI_DATA_64 : PCI_MSI_DATA_32), &data);
++		if (flags & PCI_MSI_FLAGS_MASKBIT) {
++			int off = (flags & PCI_MSI_FLAGS_64BIT) ? PCI_MSI_MASK_64 : PCI_MSI_MASK_32;
++			pci_read_config_dword(pdev, cap + off, &mask);
++			pci_read_config_dword(pdev, cap + off + 4, &pending);
++		}
++	}
++	seq_printf(m, "pci=%s alive=%u msi_flags=%#x address=0x%08x%08x data_base=%#x mask=%#x pending=%#x nr_irqs=%u\n",
++		   pci_name(pdev), alive, flags, hi, lo, data & 0xffff, mask, pending, cntrl->nr_irqs);
++	for (i = 0; i < cntrl->nr_irqs; i++) {
++		struct irq_data *irqd = irq_get_irq_data(cntrl->irq[i]);
++		struct msi_msg msg = { };
++
++		if (irq_get_msi_desc(cntrl->irq[i]))
++			get_cached_msi_msg(cntrl->irq[i], &msg);
++		seq_printf(m, "vector=%d linux_irq=%d expected_data=%#x cached_base=%#x cached_addr=0x%08x%08x",
++			   i, cntrl->irq[i], (data & 0xffff) + i, msg.data, msg.address_hi, msg.address_lo);
++		for (depth = 0; irqd; irqd = irqd->parent_data, depth++)
++			seq_printf(m, " domain%d=%s hwirq%d=%lu chip%d=%s disabled%d=%u masked%d=%u",
++				   depth, irqd->domain ? irqd->domain->name : "none", depth,
++				   irqd->hwirq, depth, irqd->chip ? irqd->chip->name : "none",
++				   depth, irqd_irq_disabled(irqd), depth, irqd_irq_masked(irqd));
++		seq_putc(m, '\n');
++	}
++}
++
++static int mhi_diag_show(struct seq_file *m, void *unused)
++{
++	struct mhi_controller *cntrl = m->private;
++	struct mhi_diag *diag = cntrl->diag;
++	int i, s;
++
++	mutex_lock(&cntrl->pm_mutex);
++	seq_printf(m, "CKB01-MHI ts_ns=%llu id=%u enabled=%u polling=%u dead=%u consumed=%u rounds=%u pm=%#x ee=%u pending_pkts=%d\n",
++		   ktime_get_ns(), READ_ONCE(diag->id), READ_ONCE(diag->enabled),
++		   READ_ONCE(diag->polling), READ_ONCE(diag->dead), diag->consumed,
++		   diag->rounds, cntrl->pm_state, cntrl->ee, atomic_read(&cntrl->pending_pkts));
++	mhi_diag_irq_map(m, cntrl);
++	if (!mhi_is_active(cntrl) || !cntrl->mhi_ctxt)
++		goto counts;
++	for (i = 0; i < cntrl->total_ev_rings; i++) {
++		struct mhi_event *ev = &cntrl->mhi_event[i];
++		struct mhi_ring *ring = &ev->ring;
++		struct mhi_event_ctxt ctx;
++		u64 host_rp, host_wp, device_rp, raw[4][2];
++		u32 records = 0, j;
++		void *p;
++
++		if (ev->offload_ev) {
++			seq_printf(m, "er=%d offload=1\n", i);
++			continue;
++		}
++		spin_lock_bh(&ev->lock);
++		memcpy(&ctx, &cntrl->mhi_ctxt->er_ctxt[i], sizeof(ctx));
++		host_rp = ring->iommu_base + (ring->rp - ring->base);
++		host_wp = ring->iommu_base + (ring->wp - ring->base);
++		device_rp = le64_to_cpu(ctx.rp);
++		dma_rmb();
++		p = ring->rp;
++		/* Snapshot pending records only, never arbitrary memory or lost-link BARs. */
++		if (i != 0 && ring->base && device_rp >= ring->iommu_base && device_rp < ring->iommu_base + ring->len &&
++		    IS_ALIGNED(device_rp, sizeof(struct mhi_ring_element))) {
++			while (records < ARRAY_SIZE(raw) &&
++			       ring->iommu_base + (p - ring->base) != device_rp) {
++				raw[records][0] = get_unaligned_le64(p);
++				raw[records++][1] = get_unaligned_le64(p + 8);
++				p += sizeof(struct mhi_ring_element);
++				if (p >= ring->base + ring->len)
++					p = ring->base;
++			}
++		}
++		spin_unlock_bh(&ev->lock);
++		seq_printf(m, "er=%d msivec=%u linux_irq=%d intmod=%#x rbase=%#llx rlen=%#llx device_rp=%#llx host_rp=%#llx host_wp=%#llx ctxt_wp=%#llx\n",
++			   i, le32_to_cpu(ctx.msivec), cntrl->irq[ev->irq], le32_to_cpu(ctx.intmod),
++			   le64_to_cpu(ctx.rbase), le64_to_cpu(ctx.rlen), device_rp, host_rp,
++			   host_wp, le64_to_cpu(ctx.wp));
++		for (j = 0; j < records; j++)
++			seq_printf(m, "er=%d pending_record=%u ptr=%#llx dword0=%#x dword1=%#x\n",
++				   i, j, raw[j][0], (u32)raw[j][1], (u32)(raw[j][1] >> 32));
++	}
++counts:
++	for (i = 0; i <= CKB01_RINGS; i++) {
++		seq_printf(m, "er=%d", i == CKB01_RINGS ? -1 : i);
++		for (s = 0; s < MHI_DIAG_MAX; s++)
++			seq_printf(m, " %s=%lld", stage_name[s], atomic64_read(&diag->count[i][s]));
++		seq_putc(m, '\n');
++	}
++	mutex_unlock(&cntrl->pm_mutex);
++	return 0;
++}
++DEFINE_SHOW_ATTRIBUTE(mhi_diag);
++
++static ssize_t mhi_diag_control(struct file *file, const char __user *buf,
++			      size_t count, loff_t *offset)
++{
++	struct mhi_controller *cntrl = file->private_data;
++	struct mhi_diag *diag = cntrl->diag;
++	char command[16];
++	int ret = 0;
++	int i;
++	bool poll;
++
++	if (!count || count >= sizeof(command))
++		return -EINVAL;
++	if (copy_from_user(command, buf, count))
++		return -EFAULT;
++	command[count] = '\0';
++	strim(command);
++	if (!strcmp(command, "stop")) {
++		mhi_diag_stop(cntrl);
++		dev_info(cntrl->cntrl_dev, "CKB01-MHI ts_ns=%llu id=%u stage=stop consumed=%u\n",
++			 ktime_get_ns(), diag->id, diag->consumed);
++		return count;
++	}
++	if (strcmp(command, "start") && strcmp(command, "trace"))
++		return -EINVAL;
++	poll = !strcmp(command, "start");
++	mutex_lock(&diag->control);
++	if (READ_ONCE(diag->polling)) {
++		ret = -EBUSY;
++		goto out;
++	}
++	WRITE_ONCE(diag->enabled, false);
++	cancel_delayed_work_sync(&diag->work);
++	mutex_lock(&cntrl->pm_mutex);
++	if (READ_ONCE(diag->dead) || !mhi_is_active(cntrl) || !cntrl->mhi_ctxt ||
++	    cntrl->pm_state != MHI_PM_M0 || cntrl->ee != MHI_EE_AMSS) {
++		ret = -ENODEV;
++	} else {
++		diag->id++;
++		diag->consumed = 0;
++		diag->rounds = 0;
++		atomic_set(&diag->printed, 0);
++		for (i = 0; i < MHI_DIAG_MAX; i++)
++			atomic_set(&diag->samples[i], 0);
++		diag->deadline = jiffies + msecs_to_jiffies(CKB01_WINDOW_MS);
++		WRITE_ONCE(diag->polling, poll);
++		WRITE_ONCE(diag->enabled, true);
++		schedule_delayed_work(&diag->work, 0);
++		dev_info(cntrl->cntrl_dev,
++			 "CKB01-MHI ts_ns=%llu id=%u stage=window_start poll=%u window_ms=%u interval_ms=%u budget=%u total_budget=%u\n",
++			 ktime_get_ns(), diag->id, poll, CKB01_WINDOW_MS, CKB01_POLL_MS,
++			 CKB01_POLL_BUDGET, CKB01_TOTAL_BUDGET);
++	}
++	mutex_unlock(&cntrl->pm_mutex);
++out:
++	mutex_unlock(&diag->control);
++	return ret ? ret : count;
++}
++
++static const struct file_operations mhi_diag_control_fops = {
++	.owner = THIS_MODULE,
++	.open = simple_open,
++	.write = mhi_diag_control,
++	.llseek = noop_llseek,
++};
