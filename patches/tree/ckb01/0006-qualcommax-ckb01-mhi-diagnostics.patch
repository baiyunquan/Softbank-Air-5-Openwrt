++	if (!count || count >= sizeof(command))
++		return -EINVAL;
++	if (copy_from_user(command, buf, count))
++		return -EFAULT;
++	command[count] = '\0';
++	if (!strcmp(strim(command), "stop")) {
++		WRITE_ONCE(diag->deadline_ns, 0);
