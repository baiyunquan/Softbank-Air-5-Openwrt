++static int dw_ckb01_show(struct seq_file *m, void *unused)
++{
++	struct dw_ckb01_msi *diag = m->private;
++	struct dw_pcie_rp *pp = diag->pp;
++	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
++	struct pci_dev *ep;
++	unsigned long flags;
++	u16 vendor = 0xffff;
++	int i, j;
++	bool alive;
++
++	raw_spin_lock_irqsave(&pp->lock, flags);
++	ep = pci_dev_get(diag->endpoint);
++	raw_spin_unlock_irqrestore(&pp->lock, flags);
++	alive = ep && !pci_read_config_word(ep, PCI_VENDOR_ID, &vendor) && vendor == 0x17cb;
