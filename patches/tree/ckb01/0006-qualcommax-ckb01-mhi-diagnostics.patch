++void mhi_diag_init(struct mhi_controller *cntrl)
++{
++	struct pci_dev *pdev;
++	struct mhi_diag *diag;
++
++	if (!dev_is_pci(cntrl->cntrl_dev) || !of_machine_is_compatible("oppo,ckb01"))
++		return;
++	pdev = to_pci_dev(cntrl->cntrl_dev);
++	if (pdev->vendor != 0x17cb || pdev->device != 0x0306 ||
++	    pdev->subsystem_vendor != 0x17cb || pdev->subsystem_device != 0x010c)
++		return;
++	diag = kzalloc(sizeof(*diag), GFP_KERNEL);
++	if (!diag) {
++		dev_warn(cntrl->cntrl_dev, "CKB01-MHI diagnostic allocation failed\n");
++		return;
++	}
++	diag->cntrl = cntrl;
++	mutex_init(&diag->control);
++	INIT_DELAYED_WORK(&diag->work, mhi_diag_work);
++	cntrl->diag = diag;
++	debugfs_create_file("ckb01_diag", 0400, cntrl->debugfs_dentry, cntrl, &mhi_diag_fops);
++	debugfs_create_file("ckb01_poll", 0200, cntrl->debugfs_dentry, cntrl, &mhi_diag_control_fops);
++	dev_info(cntrl->cntrl_dev, "CKB01-MHI diagnostics ready; polling=off\n");
++}
++
++void mhi_diag_destroy(struct mhi_controller *cntrl)
++{
++	mhi_diag_stop(cntrl);
++	kfree(cntrl->diag);
++	cntrl->diag = NULL;
++}
