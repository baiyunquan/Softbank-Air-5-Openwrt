#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034
# START/USE_PROCD are consumed by /etc/rc.common.

START=95
USE_PROCD=1

start_service() {
	. /lib/functions/system.sh
	[ "$(board_name)" = 'oppo,ckb01' ] || return 0
	procd_open_instance
	# A hard deadline also covers slow external commands, beyond retry sleeps.
	procd_set_param command /usr/libexec/timeout-coreutils -k 1 120 /usr/sbin/ckb01-wifi-setup
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
