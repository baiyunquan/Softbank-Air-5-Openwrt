#!/bin/sh /etc/rc.common
# Revalidate this unit's ART before S10boot loads ath11k. /tmp is new each boot,
# while a persistent root may already contain the previous calibration file.
START=09

start() {
	. /lib/functions/system.sh
	[ "$(board_name)" = oppo,ckb01 ] || return 0
	. /lib/functions/ckb01-wifi.sh
	local art size
	art=$(ckb01_find_art_chardev)
	size=
	[ -z "$art" ] || size=$(cat "/sys/class/mtd/${art##*/}/size" 2>/dev/null)
	if ckb01_caldata_extract "$art" "$size" \
		/lib/firmware/ath11k/IPQ8074/hw2.0/cal-ahb-c000000.wifi.bin \
		/tmp/ckb01-caldata.status; then
		echo 'ckb01-caldata: unit ART validated before ath11k startup'
	else
		echo 'ckb01-caldata: validation failed; inspect /tmp/ckb01-caldata.status' >&2
		return 1
	fi
}
