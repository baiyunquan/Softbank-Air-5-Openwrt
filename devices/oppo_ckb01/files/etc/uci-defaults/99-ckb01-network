#!/bin/sh
# RAM-root defaults: physical LAN1 -> WAN, physical LAN2 -> management LAN.
. /lib/functions/system.sh

[ "$(board_name)" = "oppo,ckb01" ] || exit 0

valid_mac() {
	printf '%s\n' "$1" | grep -Eq '^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$' || return 1
	case "$1" in
		00:00:00:00:00:00|ff:ff:ff:ff:ff:ff|00:03:7f:ba:db:ad) return 1 ;;
	esac
	[ "$((0x${1%%:*} & 1))" -eq 0 ]
}

dt_mac() {
	file="/sys/firmware/devicetree/base/soc@0/ppe@3a000000/ports/port@$1/local-mac-address"
	[ -r "$file" ] || return 1
	hexdump -v -e '6/1 "%02x:"' "$file" | sed 's/:$//'
}

wan_mac=$(dt_mac 1)
lan_mac=$(dt_mac 2)
source=bootloader
if ! valid_mac "$wan_mac"; then
	if valid_mac "$lan_mac"; then
		wan_mac=$(macaddr_add "$lan_mac" 1)
	else
		art=$(find_mtd_chardev '0:art')
		[ -n "$art" ] || art=$(find_mtd_chardev '0:ART')
		[ -n "$art" ] || art=$(find_mtd_chardev ART)
		if [ -n "$art" ] && [ -r "$art" ]; then
			seed=$(sha256sum "$art" | awk '{print $1}')
			source=ART-sha256
		elif [ -s /sys/devices/soc0/serial_number ]; then
			seed=$(sha256sum /sys/devices/soc0/serial_number | awk '{print $1}')
			source=soc-serial-sha256
		else
			seed=$(hexdump -v -n 6 -e '6/1 "%02x"' /dev/urandom)
			source=random-no-device-identity
		fi
		first=$(printf '%s' "$seed" | cut -c1-2)
		wan_mac=$(printf '%02x:%s' "$(( (0x$first & 254) | 2 ))" \
			"$(printf '%s' "$seed" | cut -c3-12 | sed 's/../&:/g;s/:$//')")
	fi
fi
if ! valid_mac "$lan_mac" || [ "$lan_mac" = "$wan_mac" ]; then
	lan_mac=$(macaddr_add "$wan_mac" 1)
fi
valid_mac "$wan_mac" && valid_mac "$lan_mac" || exit 1

uci -q batch <<EOF
set network.lan.ipaddr='192.168.5.1'
set network.lan.netmask='255.255.255.0'
set network.lan.macaddr='$lan_mac'
set network.wan.proto='dhcp'
set network.wan.metric='20'
set network.wan6.metric='20'
set network.cellular=interface
set network.cellular.proto='ckb01_qmi'
set network.cellular.apn='3gnet'
set network.cellular.metric='10'
set network.cellular.auto='0'
set network.wan.macaddr='$wan_mac'
set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set firewall.@defaults[0].flow_offloading='0'
set firewall.@defaults[0].flow_offloading_hw='0'
set system.@system[0].hostname='ckb01'
commit network
commit dhcp
commit firewall
commit system
EOF
# Preserve the existing WAN zone and append cellular only once.
for zone in $(uci -q show firewall | sed -n 's/^firewall\.\([^=]*\)=zone$/\1/p'); do
 [ "$(uci -q get "firewall.$zone.name")" = wan ] || continue
 uci -q del_list "firewall.$zone.network=cellular"
 uci add_list "firewall.$zone.network=cellular"
done
uci commit firewall
printf 'source=%s\nwan=%s\nlan=%s\n' "$source" "$wan_mac" "$lan_mac" >/tmp/ckb01-mac-source
logger -t ckb01 "MAC source: $source; physical LAN1=wan, LAN2=lan"
exit 0
