#!/bin/sh
# Auto-expand Partition 2 (AIR5ROOT) to fill remaining physical disk space

root_dev=$(awk '$2 == "/" && $3 == "ext4" { print $1; exit }' /proc/mounts)
case "$root_dev" in
    /dev/sd[a-z]2)
        root_name=${root_dev##*/}
        sys_root="/sys/class/block/$root_name"
        [ "$(cat "$sys_root/partition" 2>/dev/null)" = 2 ] || exit 1
        disk_name=$(basename "$(readlink -f "$sys_root/..")")
        disk="/dev/$disk_name"
        if [ -b "$disk" ]; then
            disk_sectors=$(cat "/sys/class/block/$disk_name/size") || exit 1
            root_start=$(cat "$sys_root/start") || exit 1
            root_sectors=$(cat "$sys_root/size") || exit 1
            if [ "$root_sectors" -lt "$((disk_sectors - root_start))" ]; then
                logger -t ckb01-expand "Expanding partition 2 on $disk; boot partition stays unchanged"
                printf ", +\n" | sfdisk --no-reread --no-tell-kernel -N 2 --force "$disk" || exit 1
                # Update only partition 2, leaving mounted partition 1 alone.
                partx -u --nr 2 "$disk" || {
                    logger -t ckb01-expand "Partition table updated; reboot needed before resize; will retry"
                    exit 1
                }
            fi
            resize2fs "$root_dev" || {
                logger -t ckb01-expand "Filesystem resize failed; will retry next boot"
                exit 1
            }
            logger -t ckb01-expand "Root filesystem resized. Available: $(df -h / | awk 'NR==2 {print $2}')"
        else
            exit 1
        fi
        ;;
    *)
        logger -t ckb01-expand "Rootfs is not on /dev/sd*2 ($root_dev), skipping expand."
        ;;
esac

exit 0
