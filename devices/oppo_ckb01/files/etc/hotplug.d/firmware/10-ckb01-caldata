#!/bin/sh

case "$FIRMWARE" in
	*cal-ahb-c000000.wifi.bin*) ;;
	*) exit 0 ;;
esac
. /lib/functions/system.sh
[ "$(board_name)" = 'oppo,ckb01' ] || exit 0
. /lib/functions/ckb01-wifi.sh

art=$(ckb01_find_art_chardev)
size=
[ -z "$art" ] || size=$(cat "/sys/class/mtd/${art##*/}/size" 2>/dev/null)
ckb01_caldata_extract "$art" "$size" "/lib/firmware/$FIRMWARE" /tmp/ckb01-caldata.status
