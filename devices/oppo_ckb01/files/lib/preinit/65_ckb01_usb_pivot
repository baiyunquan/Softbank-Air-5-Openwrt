#!/bin/sh
# CKB01 USB persistent root pivot hook

ckb01_usb_pivot() {
    [ -f /etc/.ckb01_pivoted ] && return 0

    local target_dev=""
    for i in $(seq 1 10); do
        if [ -b "/dev/disk/by-label/AIR5ROOT" ]; then
            target_dev="/dev/disk/by-label/AIR5ROOT"
            break
        elif [ -b "/dev/sda2" ]; then
            target_dev="/dev/sda2"
            break
        fi
        sleep 0.5
    done

    if [ -n "$target_dev" ]; then
        echo "[CKB01] Detected persistent ext4 root partition at $target_dev"
        mkdir -p /mnt/rootfs
        if mount -t ext4 -o rw,noatime "$target_dev" /mnt/rootfs; then
            echo "[CKB01] Mounted $target_dev. Switching root to persistent filesystem..."
            touch /mnt/rootfs/etc/.ckb01_pivoted
            unset INITRAMFS
            exec switch_root /mnt/rootfs /sbin/init
        else
            echo "[CKB01] WARNING: Failed to mount $target_dev! Falling back to RAM initramfs."
        fi
    else
        echo "[CKB01] NOTICE: No AIR5ROOT partition detected. Continuing in RAM initramfs mode."
    fi
}

boot_hook_add preinit_main ckb01_usb_pivot
