#!/bin/sh
# Collect evidence without changing GPIOs, modem state, or flash contents.
. /lib/functions/system.sh
. /lib/functions/ckb01-wifi.sh

output=${1:-/tmp/ckb01-diag-$(date +%Y%m%d-%H%M%S).tar.gz}
work=$(mktemp -d /tmp/ckb01-diag.XXXXXX) || exit 1
trap 'rm -rf "$work"' EXIT HUP INT TERM
capture() {
	name=$1
	shift
	"$@" >"$work/$name.txt" 2>&1 || true
}
capture board ubus call system board
capture uname uname -a
capture dmesg dmesg
capture logread logread
capture cmdline cat /proc/cmdline
capture memory cat /proc/meminfo
capture partitions cat /proc/mtd
capture pci lspci -nnk
capture modem-discovery ckb01-modem discover
capture oem-management ckb01-oem status
# Keep module ADB inspection opt-in: diagnostic collection never enables it.
capture oem-adb-local sh -c 'command -v adb; ls -l /usr/bin/oatprsync /usr/sbin/ckb01-oem /usr/sbin/ckb01-adb; cat /usr/share/ckb01-oem/adb-payload.json'
capture modem-probe ckb01-modem probe
capture cellular ubus call network.interface.cellular status
capture cellular-counters ip -s -d link
for evidence in /tmp/ckb01-modem*.json /tmp/ckb01-modem*.jsonl /tmp/ckb01-modem-management.txt; do
 [ ! -f "$evidence" ] || cp "$evidence" "$work/"
done
capture usb lsusb
capture addresses ip -details address
capture routes ip route show table all
capture network ubus call network.interface dump
capture uci-network uci export network
capture uci-firewall uci export firewall
capture mac-source cat /tmp/ckb01-mac-source
capture wifi-setup cat /tmp/ckb01-wifi.status
capture wifi-caldata cat /tmp/ckb01-caldata.status
capture wireless ubus call network.wireless status
capture uci-wireless uci export wireless
capture iw-phy iw phy
capture iw-dev iw dev
capture iw-reg iw reg get
capture iwinfo iwinfo
capture wifi-fw-version cat /lib/firmware/IPQ8074/fw_version.txt
capture wifi-bdf-sha256 sha256sum /lib/firmware/ath11k/IPQ8074/hw2.0/board-2.bin
for interface in $(iw dev 2>/dev/null | awk '$1 == "Interface" {print $2}'); do
	capture "wifi-stations-$interface" iw dev "$interface" station dump
	capture "hostapd-$interface" ubus call "hostapd.$interface" get_status
	capture "hostapd-clients-$interface" ubus call "hostapd.$interface" get_clients
done
{
	for device in /sys/class/remoteproc/*; do
		[ -d "$device" ] || continue
		printf '\n%s\n' "$device"
		cat "$device/name" "$device/firmware" "$device/state" 2>/dev/null || true
	done
} >"$work/remoteproc.txt"
for interface in lan wan; do
	capture "ethtool-$interface" ethtool "$interface"
	capture "ethtool-stats-$interface" ethtool -S "$interface"
done
{
	for device in /sys/bus/mdio_bus/devices/*; do
		[ -d "$device" ] || continue
		printf '\n%s\n' "$device"
		cat "$device/phy_id" "$device/phy_interface" 2>/dev/null || true
	done
	printf '\nMHI devices:\n'
	ls -l /sys/bus/mhi/devices/ /sys/class/wwan/ /dev/wwan* /dev/mhi* 2>/dev/null || true
} >"$work/phy-mhi.txt"
art=$(ckb01_find_art_chardev)
if [ -n "$art" ] && [ -r "$art" ]; then
	capture art-sha256 sha256sum "$art"
	capture art-size cat "/sys/class/mtd/${art##*/}/size"
fi
[ ! -r /sys/firmware/fdt ] || cp /sys/firmware/fdt "$work/running.dtb"
if [ -d /sys/fs/pstore ]; then
	cp -r /sys/fs/pstore "$work/" 2>/dev/null || true
fi
printf '%s\n' 'Snapshot of the running system. Use captured carrier and PHY records to verify physical port mapping. ART contents are not included.' \
	>"$work/README.txt"
tar -czf "$output" -C "$work" . || exit 1
printf '%s\n' "$output"
